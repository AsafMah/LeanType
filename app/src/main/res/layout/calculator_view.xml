<helium314.keyboard.latin.calculator.CalculatorView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/calculator_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:visibility="gone">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Main Calculator Layout -->
        <LinearLayout
            android:id="@+id/calc_main_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingHorizontal="4dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp">

            <!-- Top Display & Quick Actions Bar -->
            <LinearLayout
                android:id="@+id/calc_display_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:layout_marginBottom="2dp">

                <!-- Header Actions Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="28dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/calc_btn_history"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:contentDescription="History"
                        android:padding="4dp"
                        android:src="@drawable/ic_undo" />

                    <ImageButton
                        android:id="@+id/calc_btn_copy"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_marginStart="4dp"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Copy"
                        android:padding="4dp"
                        android:src="@drawable/sym_keyboard_copy" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <Button
                        android:id="@+id/calc_btn_insert"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:minHeight="28dp"
                        android:minWidth="0dp"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="0dp"
                        android:text="Insert ⏎"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/calc_btn_close"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_marginStart="4dp"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Close"
                        android:padding="4dp"
                        android:src="@drawable/ic_close" />
                </LinearLayout>

                <!-- Expression Display -->
                <HorizontalScrollView
                    android:id="@+id/calc_expression_scroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:fillViewport="true">

                    <TextView
                        android:id="@+id/calc_expression_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="end|center_vertical"
                        android:singleLine="true"
                        android:text="0"
                        android:textSize="22sp"
                        android:textStyle="bold" />
                </HorizontalScrollView>

                <!-- Live Preview Result -->
                <TextView
                    android:id="@+id/calc_preview_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end|center_vertical"
                    android:singleLine="true"
                    android:text=""
                    android:textSize="14sp"
                    android:alpha="0.8" />
            </LinearLayout>

            <!-- Keypad Grid (5 Rows x 5 Columns) -->
            <LinearLayout
                android:id="@+id/calc_keypad_grid"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- Row 1: C, ( ), %, ÷, ⌫ -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <Button android:id="@+id/calc_key_clear" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="C" android:textSize="17sp" android:textStyle="bold" android:layout_margin="1.5dp" />
                    <Button android:id="@+id/calc_key_paren" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="( )" android:textSize="17sp" android:layout_margin="1.5dp" />
                    <Button android:id="@+id/calc_key_percent" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="%" android:textSize="17sp" android:layout_margin="1.5dp" />
                    <Button android:id="@+id/calc_key_div" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="÷" android:textSize="20sp" android:textStyle="bold" android:layout_margin="1.5dp" />
                    <Button android:id="@+id/calc_key_backspace" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="⌫" android:textSize="18sp" android:layout_margin="1.5dp" />
                </LinearLayout>

                <!-- Row 2: 7, 8, 9, ×, Ans -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <Button android:id="@+id/calc_key_7" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="7" android:textSize="18sp" android:layout_margin="1.5dp" />
                    <Button android:id="@+id/calc_key_8" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="8" android:textSize="18sp" android:layout_margin="1.5dp" />
                    <Button android:id="@+id/calc_key_9" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="9" android:textSize="18sp" android:layout_margin="1.5dp" />
                    <Button android:id="@+id/calc_key_mul" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="×" android:textSize="20sp" android:textStyle="bold" android:layout_margin="1.5dp" />
                    <Button android:id="@+id/calc_key_ans" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="Ans" android:textSize="14sp" android:textStyle="bold" android:layout_margin="1.5dp" />
                </LinearLayout>

                <!-- Row 3: 4, 5, 6, −, ^ -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <Button android:id="@+id/calc_key_4" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="4" android:textSize="18sp" android:layout_margin="1.5dp" />
                    <Button android:id="@+id/calc_key_5" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="5" android:textSize="18sp" android:layout_margin="1.5dp" />
                    <Button android:id="@+id/calc_key_6" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="6" android:textSize="18sp" android:layout_margin="1.5dp" />
                    <Button android:id="@+id/calc_key_sub" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="−" android:textSize="20sp" android:textStyle="bold" android:layout_margin="1.5dp" />
                    <Button android:id="@+id/calc_key_pow" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="^" android:textSize="17sp" android:textStyle="bold" android:layout_margin="1.5dp" />
                </LinearLayout>

                <!-- Row 4: 1, 2, 3, +, ± -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <Button android:id="@+id/calc_key_1" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="1" android:textSize="18sp" android:layout_margin="1.5dp" />
                    <Button android:id="@+id/calc_key_2" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="2" android:textSize="18sp" android:layout_margin="1.5dp" />
                    <Button android:id="@+id/calc_key_3" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="3" android:textSize="18sp" android:layout_margin="1.5dp" />
                    <Button android:id="@+id/calc_key_add" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="+" android:textSize="20sp" android:textStyle="bold" android:layout_margin="1.5dp" />
                    <Button android:id="@+id/calc_key_negate" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="±" android:textSize="17sp" android:layout_margin="1.5dp" />
                </LinearLayout>

                <!-- Row 5: ABC, 0, ., 00, = -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <Button android:id="@+id/calc_key_abc" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="⌨" android:textSize="18sp" android:layout_margin="1.5dp" />
                    <Button android:id="@+id/calc_key_0" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="0" android:textSize="18sp" android:layout_margin="1.5dp" />
                    <Button android:id="@+id/calc_key_dot" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="." android:textSize="20sp" android:textStyle="bold" android:layout_margin="1.5dp" />
                    <Button android:id="@+id/calc_key_00" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="00" android:textSize="16sp" android:layout_margin="1.5dp" />
                    <Button android:id="@+id/calc_key_equals" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="=" android:textSize="22sp" android:textStyle="bold" android:layout_margin="1.5dp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- History Overlay Panel -->
        <LinearLayout
            android:id="@+id/calc_history_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone"
            android:padding="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/calc_history_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Calculation History"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/calc_btn_clear_history"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:minHeight="32dp"
                    android:text="Clear"
                    android:textSize="12sp" />

                <ImageButton
                    android:id="@+id/calc_btn_close_history"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="4dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Close History"
                    android:padding="6dp"
                    android:src="@drawable/ic_close" />
            </LinearLayout>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <LinearLayout
                    android:id="@+id/calc_history_list_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>
        </LinearLayout>

    </FrameLayout>
</helium314.keyboard.latin.calculator.CalculatorView>
